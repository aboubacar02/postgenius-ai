# ── Copiez ce fichier en .env et renseignez vos clés ──────────────────────────

# Public (front) — sans danger côté client
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# SECRET (serveur uniquement) — JAMAIS de préfixe VITE_ sinon exposé dans le bundle.
# La clé Gemini est lue par le proxy /api/gemini/* et ne quitte jamais le serveur.
#
# Rotation de clés (recommandé pour le quota gratuit) : plusieurs clés séparées
# par des virgules. En cas de 429 / quota dépassé, le serveur bascule automatiquement
# sur la clé suivante.
GEMINI_API_KEYS=cle1,cle2,cle3

# Repli si tu n'as qu'une seule clé :
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Secrets paiement (serveur uniquement) — lire les docs Paystack / CinetPay
# PAYSTACK_SECRET_KEY=sk_test_xxx
# CINETPAY_API_KEY=xxx
# CINETPAY_SITE_ID=xxx
