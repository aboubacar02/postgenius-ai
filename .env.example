# ── Copiez ce fichier en .env et renseignez vos clés ──────────────────────────
# Ne poussez JAMAIS votre fichier .env dans git : il contient vos secrets.

# ══════════════════════════════════════════════════════════════════════════════
# PUBLIC (front) — sans danger côté client (préfixe VITE_ requis pour être lus
# par l'app React).
# ══════════════════════════════════════════════════════════════════════════════
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ══════════════════════════════════════════════════════════════════════════════
# LLM & IA CENTRALE — serveur uniquement (JAMAIS de préfixe VITE_ sinon exposé
# dans le bundle). Lues par le proxy /api/gemini/*, elles ne quittent jamais le
# serveur.
# ══════════════════════════════════════════════════════════════════════════════
# Rotation de clés (recommandé pour le quota gratuit) : plusieurs clés séparées
# par des virgules. En cas de 429 / quota dépassé, le serveur bascule
# automatiquement sur la clé suivante.
GEMINI_API_KEYS=cle1,cle2,cle3
# Repli si tu n'as qu'une seule clé :
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# TTS IA (synthèse vocale du chat agent). Sans cette clé, le chat bascule
# automatiquement sur les voix Edge (node-edge-tts, sans clé).
# ELEVENLABS_API_KEY=your_elevenlabs_key

# ══════════════════════════════════════════════════════════════════════════════
# YOUTUBE & TENDANCES — serveur uniquement.
# Active la recherche YouTube en temps réel (section Tendances). Sans clé, la
# section affiche des vidéos de démonstration.
# ══════════════════════════════════════════════════════════════════════════════
YOUTUBE_API_KEY=AIzaSy...
VITE_YOUTUBE_API_KEY=AIzaSy...
# ══════════════════════════════════════════════════════════════════════════════
# B-ROLL (images du module Faceless Video) — serveur uniquement.
# Sans clé Pexels, le module utilise des images libres de droit (Picsum) pour la
# démo.
# ══════════════════════════════════════════════════════════════════════════════
PEXELS_API_KEY=your_pexels_api_key

# ══════════════════════════════════════════════════════════════════════════════
# AUTHENTIFICATION & PAIEMENT — serveur uniquement.
# ══════════════════════════════════════════════════════════════════════════════
# Google OAuth (bouton « Se connecter avec Google ») : activez le provider Google
# dans votre projet Supabase (Auth → Providers → Google) puis collez :
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# NEXTAUTH_SECRET=your_nextauth_secret

# Paiements réels : chaque passerelle fonctionne dès que sa clé est renseignée.
# Sans clé, le flux reste en mode test simulé (aucun débit).

# Stripe (cartes bancaires internationales)
STRIPE_SECRET_KEY=sk_test_xxx
# Mode PayPal : 'sandbox' par défaut, passer à 'live' pour la production.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Mobile Money Afrique (Wave, Orange Money, MTN MoMo) via Paystack / CinetPay
PAYSTACK_SECRET_KEY=sk_test_xxx
CINETPAY_API_KEY=xxx
CINETPAY_SITE_ID=xxx

# URL de base du site (utilisée pour les retours de paiement Stripe/PayPal).
SITE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=794263722734-iliq80l18mrtg81ap0gr0mnohc7j8n10.apps.googleusercontent.com